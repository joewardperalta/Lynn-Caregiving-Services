PORT=3000
NODE_ENV=development

# Owner notification email (required for forms)
OWNER_EMAIL=lynncaregiving@gmail.com

# Must use an address on your verified Resend domain
FROM_EMAIL=requests@lynncaregiving.com

# Resend SMTP
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=resend
EMAIL_PASSWORD=

# Optional confirmation email to the person who submitted the form
SEND_CONFIRMATION_EMAIL=true

SITE_URL=https://www.lynncaregiving.com

# Optional later: PostgreSQL is not required right now.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/psw_services
